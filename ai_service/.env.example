DATA_SOURCE=synthetic
SYNTHETIC_DATA_PATH=./data/snapshot.json
BACKEND_URL=http://127.0.0.1:8000
# Short-lived Bearer token of a dedicated read-only backend account when available.
BACKEND_TOKEN=
# Required to access non-public /ai routes. Use a long random value.
AI_SERVICE_TOKEN=
AI_DATABASE_URL=
# Set true only after confirming a PostgreSQL URL targets a separate ai database.
AI_DB_CONFIRMED_SEPARATE=false
DEMO_MODE=true
LLM_PROVIDER=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_MODEL_VISION=
STT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHATS={}
DEADLINE_SCHEDULER_ENABLED=false
DEADLINE_POLL_SECONDS=60
DUE_SOON_MINUTES=30
ACCEPT_MINUTES=10
EMERGENCY_ACCEPT_MINUTES=3
REMINDER_REPEAT_MINUTES=30
MANAGER_ESCALATION_MINUTES=90
RATING_WEIGHTS={"quality":0.30,"on_time":0.25,"no_rework":0.15,"no_repeat":0.15,"volume":0.10,"no_unjustified_refusal":0.05}
