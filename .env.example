# Development / demonstration only. Copy to .env if overrides are needed.
POSTGRES_DB=naryad_ai
POSTGRES_USER=naryad
POSTGRES_PASSWORD=demo-only-change-me
API_PORT=8000
WEB_PORT=8080
SEED_DEMO=true
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional OpenAI access for new work-order reviews and the web analytics narrative.
# Keep the real value only in the ignored local .env; never commit it.
OPENAI_API_KEY=

# Durable background review; the provider uses OpenAI when the key is set.
# queued_stub acknowledges the report first; inline_stub keeps the old sync flow.
AI_REVIEW_MODE=queued_stub

# Local mode without Docker; ignored by the Compose DATABASE_URL configuration.
# DATABASE_URL=sqlite:///./data/naryad.db
# PostgreSQL passwords in DATABASE_URL must be URL-encoded when necessary.

# FCM push. Filesystem path to the Firebase service-account JSON.
# FIREBASE_CREDENTIALS_JSON (below) takes priority when both are set.
FIREBASE_CREDENTIALS=
# Alternative to FIREBASE_CREDENTIALS: the whole service-account JSON inline.
# Takes priority over FIREBASE_CREDENTIALS. Normally exported from the shell
# (it is multi-line) rather than pasted into .env.
# Delivery requires explicit PUSH_ENABLED=true and one configured credential channel.
FIREBASE_CREDENTIALS_JSON=
# Firebase project for the FCM HTTP v1 API.
FIREBASE_PROJECT_ID=km-case-hack
# Set true explicitly to enable real delivery.
PUSH_ENABLED=false
# Background dispatch interval in seconds.
PUSH_DISPATCH_SECONDS=3
# Delivery attempts before a push task is marked failed.
PUSH_MAX_ATTEMPTS=8

