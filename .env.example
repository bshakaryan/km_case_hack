# Development / demonstration only. Copy to .env if overrides are needed.
POSTGRES_DB=naryad_ai
POSTGRES_USER=naryad
POSTGRES_PASSWORD=demo-only-change-me
API_PORT=8000
WEB_PORT=8080
SEED_DEMO=true
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Enable external AI only after approving what data may leave the environment.
AI_PROVIDER=stub
AI_MODEL=gpt-4.1-mini
# OPEN_AI_API_KEY=

# Deadline monitor thresholds (minutes). Notifications are stored in the app;
# native push delivery is not connected yet.
DUE_SOON_MINUTES=30
ACCEPT_MINUTES=10
EMERGENCY_ACCEPT_MINUTES=3
REMINDER_REPEAT_MINUTES=30
MANAGER_ESCALATION_MINUTES=60

# Local mode without Docker; ignored by the Compose DATABASE_URL configuration.
# DATABASE_URL=sqlite:///./data/naryad.db
# PostgreSQL passwords in DATABASE_URL must be URL-encoded when necessary.

