# Generate local values with: python3 scripts/setup_env.py
# Do not commit .env. Values below are placeholders, never real credentials.
POSTGRES_PASSWORD=replace-with-generated-value
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_PASSWORD=replace-with-at-least-12-characters
DATABASE_URL=sqlite:///./jana.db
# Optional host ports. Containers always use 3000/8000 internally.
WEB_PORT=3000
API_PORT=8000
# Local run: start app.mock_zup on 8300. Docker uses its internal URL.
ZUP_BASE_URL=http://127.0.0.1:8300/hs/jana/v1
ZUP_MODE=mock
ZUP_AUTH_TYPE=bearer
ZUP_API_TOKEN=replace-with-at-least-32-random-characters
# Real 1C: use ZUP_MODE=real and an HTTPS URL. Choose either Bearer above or Basic below.
# For Docker, set ZUP_DOCKER_BASE_URL to an address reachable from containers.
# ZUP_DOCKER_BASE_URL=https://zup-test.example.kz/company/hs/jana/v1
# ZUP_USERNAME=jana-service
# ZUP_PASSWORD=replace-with-1c-service-password
# Paths below must be mounted read-only into migrate, backend and zup-worker.
# ZUP_CA_BUNDLE=/run/secrets/company-ca.pem
# ZUP_CLIENT_CERT=/run/secrets/jana-client.crt
# ZUP_CLIENT_KEY=/run/secrets/jana-client.key
# ZUP_TIMEOUT_SECONDS=5
# ZUP_VERIFY_TLS=true
# Only for an isolated test network; never for production:
# ZUP_ALLOW_INSECURE_HTTP=false
