// Шаблон модуля HTTP-сервиса JanaZup, контракт jana-zup-v1.
// Имена обработчиков связываются с шаблонами HTTP-сервиса в расширении.
// Общий серверный модуль JanaZupIntegration реализует обращения к объектам
// конкретного релиза ЗУП. Этот файл нельзя считать готовым расширением без
// заполнения и проверки этих функций специалистом 1С на тестовой базе.

Функция EmployeesGET(Запрос)
    Возврат JSONОтвет(200, JanaZupIntegration.ПолучитьСотрудников());
КонецФункции

Функция LeaveBalanceGET(Запрос)
    Идентификатор = Запрос.ПараметрыURL.Получить("employee_id");
    Если ПустаяСтрока(Идентификатор) Тогда
        Возврат ОшибкаJSON(422, "Не указан employee_id");
    КонецЕсли;
    Возврат JSONОтвет(200, JanaZupIntegration.ПолучитьОстаток(Идентификатор));
КонецФункции

Функция LeaveCalculatePOST(Запрос)
    Данные = ПрочитатьТелоJSON(Запрос);
    // Общий модуль возвращает безопасную бизнес-ошибку как Структуру
    // КодHTTP/detail. Не преобразуйте произвольные технические сбои в 409/422:
    // они должны остаться повторяемыми ошибками 5xx без внешнего стека.
    Результат = JanaZupIntegration.РассчитатьОтпуск(
        Данные.employee_id, Данные.start_date, Данные.end_date);
    Если Результат.Свойство("КодHTTP") Тогда
        Возврат ОшибкаJSON(Результат.КодHTTP, Результат.detail);
    КонецЕсли;
    Возврат JSONОтвет(200, Результат);
КонецФункции

Функция LeaveDocumentsPOST(Запрос)
    КлючКоманды = Запрос.Заголовки.Получить("Idempotency-Key");
    Если ПустаяСтрока(КлючКоманды) Тогда
        Возврат ОшибкаJSON(422, "Не указан Idempotency-Key");
    КонецЕсли;
    Данные = ПрочитатьТелоJSON(Запрос);
    // Реализация общего модуля обязана выполнять проверку ключа, повторный
    // расчёт, проведение документа и сохранение ключа одной транзакцией.
    Квитанция = JanaZupIntegration.ЗарегистрироватьОтпускИдемпотентно(
        КлючКоманды, Данные);
    Если Квитанция.Свойство("КодHTTP") Тогда
        Возврат ОшибкаJSON(Квитанция.КодHTTP, Квитанция.detail);
    КонецЕсли;
    Возврат JSONОтвет(201, Квитанция);
КонецФункции

Функция ПрочитатьТелоJSON(Запрос)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
    Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция JSONОтвет(Код, Значение)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Ответ = Новый HTTPСервисОтвет(Код);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть());
    Возврат Ответ;
КонецФункции

Функция ОшибкаJSON(Код, Текст)
    Данные = Новый Структура("detail", Текст);
    Возврат JSONОтвет(Код, Данные);
КонецФункции
